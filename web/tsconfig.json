{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The app is bundled by Vite, never by Node, so it resolves the way the bundler does.
    // That is also what lets it import @portionium/schemas straight from its TypeScript source.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
