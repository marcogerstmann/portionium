{
  "name": "@portionium/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "openapi": "vitest run test/http/openapi-snapshot.test.ts -u",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test drizzle.config.ts",
    "db:generate": "drizzle-kit generate --name",
    "user": "tsx src/cli/user.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@js-temporal/polyfill": "0.5.1",
    "@node-rs/argon2": "2.2.0",
    "@portionium/schemas": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "uuidv7": "1.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@readme/openapi-parser": "9.0.0",
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.10",
    "vitest": "5.0.0"
  }
}
