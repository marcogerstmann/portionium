{
  "name": "portionium",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @portionium/api dev",
    "dev:web": "pnpm --filter @portionium/web dev",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "adr": "node scripts/check-adr-index.js",
    "depcruise": "depcruise api/src packages/schemas/src web/src --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise api/src packages/schemas/src web/src --config .dependency-cruiser.cjs --output-type dot",
    "audit": "pnpm audit --audit-level high",
    "secrets": "gitleaks git --redact --no-banner"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
