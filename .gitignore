# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key

# Your copy of the deployment box's configuration. The committed file is the .example, the same
# way .env works: the concrete one carries the public key that opens a real machine, and the next
# person to clone this should get a placeholder that fails rather than one that works for
# somebody else.
infra/cloud-init.yaml

# Dependencies and build output
node_modules/
dist/
build/
*.tsbuildinfo
coverage/

# SQLite and runtime data
# The -wal and -shm sidecars change on every write, ignoring only *.db is not enough.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
data/
backups/

# Generated artefacts
# The committed OpenAPI snapshot is deliberately not ignored, keep the spec, drop the codegen.
api/src/generated/

# Web build and test output. Vite writes the dev service worker to dev-dist/,
# Playwright writes the other two.
web/dev-dist/
web/test-results/
web/playwright-report/

# Editor and OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.swp

# Logs and temp
*.log
logs/
tmp/
.cache/
